# Bootlabs Commerce — local/development template.
# Copy to `.env` and fill in values. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=bootlabs
POSTGRES_PASSWORD=bootlabs
POSTGRES_DB=bootlabs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://bootlabs:bootlabs@localhost:5432/bootlabs

# Docker/internal hosts use service names, e.g.
# DATABASE_URL=postgres://bootlabs:bootlabs@postgres:5432/bootlabs

# Disable TLS against the local Compose Postgres instance.
DATABASE_SSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Medusa HTTP ---
MEDUSA_HOST=0.0.0.0
MEDUSA_PORT=9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:8000

# Development-only placeholders. Rotate before any shared or production use.
JWT_SECRET=change-me-jwt-secret-dev-only
COOKIE_SECRET=change-me-cookie-secret-dev-only

# --- One-time Docker/production admin bootstrap (optional) ---
# Set BOTH variables for the first `pnpm compose:up`, then remove
# MEDUSA_ADMIN_PASSWORD from `.env` (and ideally MEDUSA_ADMIN_EMAIL too).
# Do not commit real passwords. The bootstrap never logs the password.
# MEDUSA_ADMIN_EMAIL=admin@bootlabs.local
# MEDUSA_ADMIN_PASSWORD=

# --- Storefront ---
STOREFRONT_PORT=8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=de
# Created later in Medusa Admin → Settings → API Key Management
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_placeholder_phase0

# --- Stripe TEST MODE only (Phase 1+). Use sk_test_ / pk_test_ keys. ---
# Leave empty in Phase 0. Do not put live keys here.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (Phase 3+). Leave empty for now. ---
S3_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
