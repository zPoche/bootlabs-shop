# Duplicate of the root `.env.example` for Docker/Compose operators.
# The canonical file is `/.env.example`. Copy that to `/.env`.

NODE_ENV=development
POSTGRES_USER=bootlabs
POSTGRES_PASSWORD=bootlabs
POSTGRES_DB=bootlabs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://bootlabs:bootlabs@localhost:5432/bootlabs
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
MEDUSA_HOST=0.0.0.0
MEDUSA_PORT=9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:8000
JWT_SECRET=change-me-jwt-secret-dev-only
COOKIE_SECRET=change-me-cookie-secret-dev-only
# Optional one-time admin bootstrap. Set BOTH, then remove the password.
# MEDUSA_ADMIN_EMAIL=admin@bootlabs.local
# MEDUSA_ADMIN_PASSWORD=
# MEDUSA_COOKIE_SECURE=false
STOREFRONT_PORT=8000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=de
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_placeholder_phase0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=
S3_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
