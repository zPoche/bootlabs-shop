FROM node:22-bookworm-slim AS base
ENV COREPACK_ENABLE_NETWORK=0
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g pnpm@10.33.3
WORKDIR /server

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/storefront/package.json apps/storefront/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/bootlabs-configurator/package.json packages/bootlabs-configurator/package.json
COPY packages/medusa-plugin-configurator/package.json packages/medusa-plugin-configurator/package.json
COPY packages/medusa-plugin-devices/package.json packages/medusa-plugin-devices/package.json
COPY packages/medusa-plugin-operations/package.json packages/medusa-plugin-operations/package.json
COPY packages/medusa-plugin-rental/package.json packages/medusa-plugin-rental/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
ENV NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
ENV NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_placeholder_phase0
ENV NEXT_PUBLIC_DEFAULT_REGION=de
RUN pnpm --filter @bootlabs/storefront build

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=8000
ENV HOSTNAME=0.0.0.0
WORKDIR /server
COPY --from=build /server/apps/storefront/.next/standalone ./
COPY --from=build /server/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=build /server/apps/storefront/public ./apps/storefront/public
COPY infra/storefront-entrypoint.sh /server/infra/storefront-entrypoint.sh
RUN chmod +x /server/infra/storefront-entrypoint.sh
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=10 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1
ENTRYPOINT ["/server/infra/storefront-entrypoint.sh"]
