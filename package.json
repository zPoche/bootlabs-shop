{
  "name": "bootlabs-shop",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bootlabs/backend --filter @bootlabs/storefront dev",
    "dev:backend": "pnpm --filter @bootlabs/backend dev",
    "dev:storefront": "pnpm --filter @bootlabs/storefront dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --parallel --filter @bootlabs/backend --filter @bootlabs/storefront start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && vitest run --config vitest.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "backend:seed": "pnpm --filter @bootlabs/backend seed",
    "compose:up": "docker compose -f infra/compose.yaml --env-file .env up --build -d",
    "compose:down": "docker compose -f infra/compose.yaml down",
    "compose:logs": "docker compose -f infra/compose.yaml logs -f",
    "compose:ps": "docker compose -f infra/compose.yaml ps"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "prettier": "^3.6.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "unrs-resolver"
    ]
  }
}
