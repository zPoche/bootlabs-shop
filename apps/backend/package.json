{
  "name": "@bootlabs/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bootlabs Medusa v2 backend (official create-medusa-app layout)",
  "author": "Bootlabs",
  "license": "MIT",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "node ./scripts/run-medusa.cjs build",
    "start": "node ./scripts/run-medusa.cjs start",
    "dev": "node ./scripts/run-medusa.cjs develop",
    "lint": "node ./scripts/run-medusa.cjs lint",
    "typecheck": "tsc --noEmit",
    "test": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "seed": "node ./scripts/run-medusa.cjs exec ./src/scripts/seed.ts",
    "bootstrap:admin": "node ./scripts/run-medusa.cjs exec ./src/scripts/bootstrap-admin.ts",
    "db:migrate": "node ./scripts/run-medusa.cjs db:migrate",
    "user": "node ./scripts/run-medusa.cjs user"
  },
  "dependencies": {
    "@bootlabs/configurator": "workspace:*",
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/admin-shared": "2.20.1",
    "@medusajs/caching": "2.20.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/dashboard": "2.20.1",
    "@medusajs/draft-order": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@medusajs/ui": "4.2.3",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.20.1",
    "@medusajs/test-utils": "2.20.1",
    "jiti": "^2.7.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
